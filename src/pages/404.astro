---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteMeta, withBase } from '../lib/site';
---

<BaseLayout title="Not found" description="The requested page could not be found.">
  <div class="page">
    <header class="page-head">
      <p class="identity">{siteMeta.identity}</p>
      <h1>Not found</h1>
      <p class="lead">This page is not here. The archive is probably the best place to continue.</p>
      <p><a href={withBase('/blogs/')}>Go to blogs</a></p>
    </header>
  </div>
</BaseLayout>
