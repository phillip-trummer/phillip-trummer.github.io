---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import { siteMeta, sortByDateDesc, withBase } from '../lib/site';

const posts = sortByDateDesc(await getCollection('posts', ({ data }) => !data.draft));

const focusAreas = [
  {
    title: 'LLM inference',
    detail:
      'GPU kernel optimization and serving performance, from CUDA and Triton kernels to attention backends and GPU databases, measured with benchmarks that reflect how the application actually runs.',
  },
  {
    title: 'AI agent & harness engineering',
    detail:
      'Long-running LLM agents and the harnesses that sustain them, including tool integration, memory across sessions, session handling, and evaluation.',
  },
  {
    title: 'Product engineering',
    detail:
      'Full-stack applications spanning product strategy, system architecture, and user experience.',
  },
];
---

<BaseLayout title={siteMeta.title} description={siteMeta.description}>
  <div class="page">
  <header class="page-head">
    <p class="identity">{siteMeta.identity}</p>
    <h1>ML Systems Engineering.</h1>
    <p class="lead">
      I am an ML systems engineer based in Zurich, specializing in LLM inference and AI agent &amp;
      harness engineering. I work across the stack, from GPU kernels and serving performance to
      long-running agent systems, and bring three years of product engineering and technical
      leadership.
    </p>
  </header>

  <section class="focus" aria-labelledby="focus-heading">
    <div class="section-heading">
      <p id="focus-heading">Focus</p>
      <a class="muted-link" href={withBase('/about/')}>about →</a>
    </div>
    <ol class="focus-list home-focus-list">
      {focusAreas.map((item) => (
        <li>
          <strong>{item.title}</strong>
          <p>{item.detail}</p>
        </li>
      ))}
    </ol>
  </section>

  {posts.length > 0 && (
    <>
      <section class="section-heading">
        <div>
          <p>Recent posts</p>
        </div>
        <a class="muted-link" href={withBase('/blogs/')}>all →</a>
      </section>
      <PostList posts={posts} limit={6} />
    </>
  )}
  </div>
</BaseLayout>
