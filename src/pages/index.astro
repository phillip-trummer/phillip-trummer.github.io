---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import { siteMeta, sortByDateDesc, withBase } from '../lib/site';

const posts = sortByDateDesc(await getCollection('posts', ({ data }) => !data.draft));

const focusAreas = [
  {
    title: 'Agents and harnesses',
    detail:
      'Long-running LLM agents and the harnesses that enable them, including tool orchestration, memory, session management, and evaluation.',
  },
  {
    title: 'Systems',
    detail:
      'Cloud architecture, model serving, accelerated computing, databases, and the broader infrastructure behind AI systems.',
  },
  {
    title: 'Product engineering',
    detail:
      'Full-stack applications spanning product strategy, system architecture, and user experience.',
  },
];
---

<BaseLayout title={siteMeta.title} description={siteMeta.description}>
  <div class="page">
  <header class="page-head">
    <p class="identity">{siteMeta.identity}</p>
    <h1>AI Systems Research and Product Engineering.</h1>
    <p class="lead">
      I am an AI systems researcher and product engineer based in Zurich, working on long-running agents, 
      GPU performance engineering, and production software.
    </p>
  </header>

  <section class="focus" aria-labelledby="focus-heading">
    <div class="section-heading">
      <p id="focus-heading">Focus</p>
      <a class="muted-link" href={withBase('/about/')}>about →</a>
    </div>
    <ol class="focus-list home-focus-list">
      {focusAreas.map((item) => (
        <li>
          <strong>{item.title}</strong>
          <p>{item.detail}</p>
        </li>
      ))}
    </ol>
  </section>

  {posts.length > 0 && (
    <>
      <section class="section-heading">
        <div>
          <p>Recent posts</p>
        </div>
        <a class="muted-link" href={withBase('/blogs/')}>all →</a>
      </section>
      <PostList posts={posts} limit={6} />
    </>
  )}
  </div>
</BaseLayout>
