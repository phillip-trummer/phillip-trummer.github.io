---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import { siteMeta, sortByDateDesc, withBase } from '../lib/site';

const posts = sortByDateDesc(await getCollection('posts', ({ data }) => !data.draft));
---

<BaseLayout title={siteMeta.title} description={siteMeta.description}>
  <section class="intro">
    <img class="intro-mark" src={withBase('/mark.svg')} alt="" width="88" height="88" />
    <p class="identity">{siteMeta.name} · researcher / engineer · Zurich</p>
    <h1>Writing, building, and learning in public.</h1>
    <p>
      I work around software systems, applied machine learning, and the small tools that make
      technical work feel more humane. This is my notebook for projects, essays, photos, and
      occasional field notes.
    </p>
  </section>

  <section class="section-heading">
    <div>
      <h2>Recent posts</h2>
      <p>Short notes and longer writeups.</p>
    </div>
    <a href={withBase('/blog/')}>all posts</a>
  </section>
  <PostList posts={posts} limit={6} />

  <section class="now">
    <h2>Now</h2>
    <ul>
      <li>Exploring practical ways to make ML systems easier to inspect.</li>
      <li>Collecting examples of personal sites that feel quiet, useful, and alive.</li>
      <li>Keeping a small photo log from walks, trains, desks, and conferences.</li>
    </ul>
  </section>
</BaseLayout>
