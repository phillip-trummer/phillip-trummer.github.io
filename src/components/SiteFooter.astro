---
import { siteMeta, withBase } from '../lib/site';

const contactLinks = [
  { label: 'email', href: `mailto:${siteMeta.email}` },
  { label: 'github', href: siteMeta.github },
  { label: 'linkedin', href: siteMeta.linkedin },
  { label: 'scholar', href: siteMeta.scholar },
  { label: 'rss', href: withBase('/rss.xml') },
].filter((link) => link.href);
---

<footer class="site-footer">
  <nav aria-label="Contact links">
    {contactLinks.map((link) => <a href={link.href}>{link.label}</a>)}
  </nav>
  <p>Built with Astro. Static, small, and easy to move.</p>
</footer>
