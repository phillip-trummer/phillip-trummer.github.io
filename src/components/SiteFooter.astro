---
import { siteMeta } from '../lib/site';

const contactLinks = [
  { label: 'email', href: `mailto:${siteMeta.email}` },
  { label: 'github', href: siteMeta.github },
  { label: 'linkedin', href: siteMeta.linkedin },
  { label: 'scholar', href: siteMeta.scholar },
].filter((link) => link.href);
---

<footer class="site-footer">
  <nav aria-label="Contact links">
    {contactLinks.map((link) => <a class="muted-link" href={link.href}>{link.label}</a>)}
  </nav>
</footer>
